{
  "name": "rust-cui-builder",
  "private": true,
  "version": "0.2.0",
  "description": "Browser client for Rust CUI Builder built with React and Vite.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n web,api \"npm run dev\" \"npm run dev:api\"",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "check:server": "node scripts/check-server.mjs",
    "check": "npm run check:server && npm run build",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^0.469.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "vite": "^5.4.10"
  }
}
