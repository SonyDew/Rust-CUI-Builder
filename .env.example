# Client-side environment variables for the web app.
# Copy this file to `.env.local` for local development.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_ENABLE_CLIENT_SECURITY=false

# Notes:
# - The frontend can boot without Supabase. In that case it switches to a
#   browser-persisted local mode for auth, projects, notifications, and tickets.
# - The app also expects backend routes under /api/security/*, /api/rcui/*,
#   and /api/stripe/* for full production functionality.
# - RCUI export/import uses server-side encryption when those endpoints exist.
