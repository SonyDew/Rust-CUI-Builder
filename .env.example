# Environment variables for the web app and optional API server.
# Copy this file to `.env.local` for local development.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_ENABLE_CLIENT_SECURITY=false

# API server
API_PORT=3000
APP_URL=http://localhost:5173
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SECURITY_EVENT_LOG=server/logs/security-events.ndjson
RCUI_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/plans
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...

# Notes:
# - The frontend can boot without Supabase. In that case it switches to a
#   browser-persisted local mode for auth, projects, notifications, and tickets.
# - The app also expects backend routes under /api/security/*, /api/rcui/*,
#   and /api/stripe/* for full production functionality.
# - Run `npm run dev:api` to start the API server on port 3000.
# - RCUI export/import uses server-side encryption when those endpoints exist.
